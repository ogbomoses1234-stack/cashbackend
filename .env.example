# ─────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
PUBLIC_DOMAIN=http://localhost:5173
ADMIN_DOMAIN=http://localhost:5174

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://qrcb:CHANGE_ME@localhost:5432/qrcb_db?schema=public

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
ADMIN_REDIS_URL=redis://:CHANGE_ME@localhost:6379/1

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
PUBLIC_JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING_AAAAAAAA
ADMIN_JWT_SECRET=REPLACE_WITH_DIFFERENT_MIN_32_CHAR_RANDOM_BBBBBBBB
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─────────────────────────────────────────────
# QR SIGNING
# ─────────────────────────────────────────────
QR_SIGNING_SECRET=REPLACE_WITH_STRONG_HMAC_SECRET_MIN_32_CHARS_CCCC
QR_BASE_URL=http://localhost:5173

# ─────────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QR CashBack Connect <noreply@yourdomain.com>"

# ─────────────────────────────────────────────
# PAYOUTS
# ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# ─────────────────────────────────────────────
# MINIO
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=qrcb-api
MINIO_SECRET_KEY=CHANGE_ME_MINIO_API_SECRET
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET_PUBLIC=qrcb-public
MINIO_BUCKET_PRIVATE=qrcb-private
MINIO_PUBLIC_URL=http://localhost:9000/qrcb-public
MINIO_SERVER_URL=http://localhost:9000

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
CORS_PUBLIC_ORIGIN=http://localhost:5173
CORS_ADMIN_ORIGIN=http://localhost:5174
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# BUSINESS
# ─────────────────────────────────────────────
CASHBACK_AMOUNT=100
MIN_WITHDRAWAL=100
SCAN_RATE_LIMIT=3
SCAN_LOCKOUT_MINUTES=10
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
DEV_AUTO_DISPATCH=false
